digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=13, nodesep=0.1, ranksep=0.17, newrank=true, mclimit=0.01, remincross=false, pad=0.03, margin=0];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12.5, fillcolor="#eceff1", color="#78909c", penwidth=1.0, margin="0.07,0.03", width=1.3, height=0.48];
  edge  [fontname="Helvetica", fontsize=11.5, color="#455a64", arrowsize=0.6];

  subgraph cluster_data { label="1  Camera / network layer"; style="rounded,filled"; fillcolor="#f4f6f7"; color="#b0bec5";
    ctx [label="Scene: weather,\nnight, occlusion"];
    uq  [label="Device UQ:\nentropy, MC var"];
    net [label="Uplink, edge\nload, cloud RTT"];
  }
  subgraph cluster_pre { label="2  Pre-processing + models"; style="rounded,filled"; fillcolor="#f4f6f7"; color="#b0bec5";
    imp  [label="Impute, IQR clip,\n2025/26 split"];
    gbm  [label="LightGBM p(err),\nlatency mu(u)"];
    grid [label="Cost tensor\nC(j,a,u), Eq. (3)", fillcolor="#fadbd8", color="#c0392b"];
  }
  subgraph cluster_aco { label="3  Proposed MAX-MIN ACO (per window)"; style="rounded,filled"; fillcolor="#fdf2f1"; color="#c0392b";
    node [fillcolor="#fadbd8", color="#c0392b"];
    ant  [label="m ants pick a_j\nP(a), Eq. (7)"];
    init [label="Greedy-J warm\nstart, tau_max"];
    ord  [label="Order frames\nby p(err|dev)"];
    feas [label="Each step: mask\ninfeasible, (4)-(6)"];
    ls   [label="1-flip local\nsearch"];
    upd  [label="Evaporate +\ndeposit, Eq. (8)"];
    gbest [label="Best plan A*\n(partition/frame)"];
    conv [shape=diamond, label="T iters\nor stall?", style="filled", margin="0.0,0.0", height=0.62, width=1.1];
  }
  subgraph cluster_eval { label="4  Evaluation"; style="rounded,filled"; fillcolor="#f4f6f7"; color="#b0bec5";
    base [label="Baselines: cloud,\ndev., greedy, RR", fillcolor="#e0e0e0"];
    twin [label="Digital twin:\nacc., latency, J"];
    abl  [label="Ablation, sens.,\nWilcoxon, IPS"];
  }
  { rank=same; ctx -> uq -> net [style=invis]; }
  { rank=same; imp -> gbm -> grid [style=invis]; }
  { rank=same; ant -> init -> ord [style=invis]; }
  { rank=same; feas -> ls -> upd [style=invis]; }
  { rank=same; gbest -> conv [style=invis]; }
  { rank=same; base -> twin -> abl [style=invis]; }
  edge [style=invis];
  ctx -> imp -> ant -> feas -> base; uq -> gbm -> init -> ls -> gbest -> twin; net -> grid -> ord -> upd -> conv -> abl;
  edge [style=solid];
  ctx -> imp; uq -> gbm; net -> gbm;
  imp -> gbm; gbm -> grid;
  grid -> ord; ord -> init [constraint=false]; init -> ant [constraint=false];
  ant -> feas [dir=both];
  ant -> ls; ls -> upd [constraint=false]; upd -> conv;
  conv -> ant [label="no", color="#c0392b", fontcolor="#c0392b", constraint=false];
  conv -> gbest [label="yes", constraint=false];
  gbest -> twin; base -> twin [constraint=false]; twin -> abl [constraint=false];
}
